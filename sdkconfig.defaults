# Use custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ESP-DL: model location in flash rodata (embedded in app binary)
# CONFIG_ESP_DL_MODEL_LOCATION_IN_FLASH_PARTITION=y
# (model in rodata is default, no extra config needed)

# Flash size: N16R8 = 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Enable PSRAM — N16R8 has 8MB Octal PSRAM
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Increase log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Disable task watchdog (each inference takes ~3s, 6 calls = 18s total)
CONFIG_TASK_WDT=n
# Keep interrupt watchdog with long timeout
CONFIG_INT_WDT_TIMEOUT_MS=30000


CONFIG_PIE_V1_BOOST=y